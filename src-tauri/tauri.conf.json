{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IHatePDF",
  "version": "2.0.0-beta.3",
  "identifier": "com.ihatepdf.desktop",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "IHatePDF",
        "width": 1280,
        "height": 850,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "resources": ["resources/pdfium.dll"],
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": { "nsis": { "installMode": "currentUser", "installerIcon": "icons/icon.ico" } }
  }
}
